#!/bin/sh
#
# pre-push hook: block the push when local CI checks, Qlty, or CodeRabbit fail.
#
# Enable it in a clone with:
#   git config core.hooksPath .githooks
#
# Optional tools (skipped when missing):
#   Qlty:        curl https://qlty.sh | sh
#   CodeRabbit:  brew install --cask coderabbit && coderabbit auth login
#
# This is a guardrail, not a guarantee: `git push --no-verify` bypasses it.
#

set -e

CODERABBIT_GATE_SEVERITY="critical"
CODERABBIT_EXIT_SUCCESS=0
CODERABBIT_EXIT_INCOMPLETE=1
CODERABBIT_EXIT_FINDINGS=2
CODERABBIT_BASE_REF="${CODERABBIT_BASE_REF:-origin/main}"
GIT_NULL_OID="0000000000000000000000000000000000000000"

# Git passes the refs that are being pushed on stdin. Read them once up front
# so later optional tools do not race for the same stream.
input=$(cat)

echo "pre-push: running pnpm check (typecheck, lint, test, build, scan)..."
pnpm check

if ! command -v qlty >/dev/null 2>&1; then
	echo "pre-push: qlty is not installed, skipping the quality check."
	echo "pre-push: install it with: curl https://qlty.sh | sh"
elif [ ! -f .qlty/qlty.toml ]; then
	echo "pre-push: .qlty/qlty.toml is missing, skipping the quality check."
else
	# Qlty prints a stray upgrade-check line ("Tap enter to skip...") whenever
	# stdin is not a terminal, which is always true here. Capture the output so
	# the exit code is kept and that one line can be dropped.
	report=$(mktemp) || exit 1
	set +e
	printf '%s\n' "$input" | qlty check \
		--trigger pre-push \
		--upstream-from-pre-push \
		--no-formatters \
		--skip-errored-plugins \
		--no-upgrade-check >"$report" 2>&1
	status=$?
	set -e
	grep -v '^Tap enter to skip\.\.\.$' "$report" || true
	rm -f "$report"

	if [ "$status" -ne 0 ]; then
		echo
		echo "pre-push: push blocked by the Qlty quality check."
		echo "pre-push: fix the issues above, or bypass once with: git push --no-verify"
		exit 1
	fi
fi

if ! command -v coderabbit >/dev/null 2>&1; then
	echo "pre-push: coderabbit is not installed, skipping the AI review."
	echo "pre-push: install it with: brew install --cask coderabbit"
	exit 0
fi

if ! git rev-parse --verify "$CODERABBIT_BASE_REF" >/dev/null 2>&1; then
	echo "pre-push: base ref '$CODERABBIT_BASE_REF' is missing, skipping CodeRabbit."
	echo "pre-push: fetch it, or set CODERABBIT_BASE_REF to another ref."
	exit 0
fi

# CodeRabbit reviews the checked-out workspace only. Require every non-delete
# push source SHA to match HEAD so the gate covers the commits being pushed.
head_sha=$(git rev-parse HEAD)
coderabbit_needed=0
	while read -r local_ref local_sha remote_ref remote_sha; do
	[ -n "$local_sha" ] || continue
	if [ "$local_sha" = "$GIT_NULL_OID" ]; then
		continue
	fi
	if [ "$local_sha" != "$head_sha" ]; then
		echo
		echo "pre-push: push blocked: CodeRabbit can only review checked-out HEAD."
		echo "pre-push: pushing $local_ref ($local_sha) while HEAD is $head_sha."
		echo "pre-push: check out that ref, then push again."
		exit 1
	fi
	coderabbit_needed=1
done <<EOF
$(printf '%s\n' "$input")
EOF

if [ "$coderabbit_needed" -eq 0 ]; then
	echo "pre-push: no non-delete refs to review with CodeRabbit."
	exit 0
fi

echo "pre-push: running CodeRabbit review (gate=$CODERABBIT_GATE_SEVERITY)..."
coderabbit_report=$(mktemp) || exit 1
set +e
coderabbit review \
	--committed \
	--base "$CODERABBIT_BASE_REF" \
	--gate "$CODERABBIT_GATE_SEVERITY" \
	--agent >"$coderabbit_report" 2>&1
coderabbit_status=$?
set -e
cat "$coderabbit_report"

if [ "$coderabbit_status" -eq "$CODERABBIT_EXIT_FINDINGS" ]; then
	rm -f "$coderabbit_report"
	echo
	echo "pre-push: push blocked by CodeRabbit ($CODERABBIT_GATE_SEVERITY or higher)."
	echo "pre-push: fix the issues above, or bypass once with: git push --no-verify"
	exit 1
fi

if [ "$coderabbit_status" -eq "$CODERABBIT_EXIT_SUCCESS" ]; then
	rm -f "$coderabbit_report"
	exit 0
fi

# Exit 1 (incomplete) and any other nonzero: block, unless the agent stream
# reports an explicitly tolerated recoverable error.
if grep -E '"type"[[:space:]]*:[[:space:]]*"error"' "$coderabbit_report" \
	| grep -E '"errorType"[[:space:]]*:[[:space:]]*"(rate_limit|auth|network)"' \
	| grep -Eq '"recoverable"[[:space:]]*:[[:space:]]*true'; then
	rm -f "$coderabbit_report"
	echo
	echo "pre-push: CodeRabbit review did not finish (exit $coderabbit_status)."
	echo "pre-push: tolerated recoverable auth, rate-limit, or network error."
	echo "pre-push: push continues; re-run locally with: coderabbit review --committed --gate $CODERABBIT_GATE_SEVERITY"
	exit 0
fi

rm -f "$coderabbit_report"
echo
echo "pre-push: push blocked by incomplete CodeRabbit review (exit $coderabbit_status)."
echo "pre-push: fix the issue above, sign in with coderabbit auth login, or bypass once with: git push --no-verify"
exit 1
