node_modules/
dist/
.wrangler/
.dev.vars
# Vite local secrets (Sentry DSN, etc.). Never commit.
.env.local
.env.*.local
# Personal Cloudflare KV/D1 ids (copy from wrangler.toml and fill in).
wrangler.local.toml
coverage/
test-results/
playwright-report/
.DS_Store
.superpowers/
docs/superpowers/
# OpenCode local agent prompts (not app source; Qlty also skips these).
# The EPUB translator agent is tracked because scripts/translate-epub.ts uses it.
.opencode/*
!.opencode/agents/
.opencode/agents/*
!.opencode/agents/translate-epub.md
.idea/

# Android TWA build output and signing material. The keystore and its
# passwords live only on the machine that signs releases; back them up.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/*.jks
android/*.keystore
android/keystore.properties

.playwright-cli/
# Security audit output (generated reports and ledgers are never committed).
security-audit/
security-audit-skill/
audit-reports/

# Generated narration packs and their transcription cache (audiobook alignment).
*.narration.zip
*.narration-transcripts/
