{
  "name": "quiosco",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node scripts/wrangler-run.mjs dev\" \"vite\"",
    "dev:api": "node scripts/wrangler-run.mjs dev",
    "dev:web": "vite",
    "build": "vite build",
    "preview:api": "node scripts/wrangler-run.mjs dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "vite-node scripts/smoke.ts",
    "e2e": "playwright test",
    "scan": "node scripts/scan-bundle.mjs",
    "deploy": "pnpm build && node scripts/wrangler-run.mjs deploy"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.143.1"
  },
  "packageManager": "pnpm@12.8.1"
}
